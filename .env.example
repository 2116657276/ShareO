# ShareO 本地配置示例。复制为 .env 后填写本机值；.env 不得提交。

# 本地服务端口
SHAREO_APP_PORT=8080
SHAREO_AI_PORT=8000
SHAREO_RUNTIME=local
SHAREO_AI_BASE_URL=http://127.0.0.1:8000
SHAREO_POST_SEARCH_SEMANTIC_THRESHOLD=0.54
SHAREO_IMAGE_SEARCH_SCORE_THRESHOLD=0.39
SHAREO_AI_REDIS_URL=redis://127.0.0.1:6379/0
SHAREO_AI_DATABASE_URL=postgresql://shareo_ai@127.0.0.1:5432/shareo?sslmode=disable
SHAREO_AI_GO_BASE_URL=http://127.0.0.1:8080

# Homebrew PostgreSQL 17 roles; passwords are required for local bootstrap.
SHAREO_PG_HOST=127.0.0.1
SHAREO_PG_PORT=5432
SHAREO_PG_DATABASE=shareo
SHAREO_PG_ADMIN_USER=
SHAREO_PG_ADMIN_PASSWORD=
SHAREO_DB_USER=shareo_app
SHAREO_DB_PASSWORD=
SHAREO_AI_DB_USER=shareo_ai
SHAREO_AI_DB_PASSWORD=
SHAREO_REDIS_PORT=6379
SHAREO_MINIO_ENDPOINT=127.0.0.1:9000
SHAREO_MINIO_BUCKET=shareo
SHAREO_MINIO_ACCESS_KEY=minioadmin
SHAREO_MINIO_SECRET_KEY=minioadmin
SHAREO_TEST_USERNAME=shareo_test
SHAREO_TEST_PASSWORD=

# 日常入口固定使用宿主机 PostgreSQL/pgvector、Redis 和 MinIO；容器运行时不参与。

# 内部服务认证；请替换为随机值，不要写入报告或截图。
SHAREO_INTERNAL_TOKEN=replace-with-a-random-value

# DeepSeek 真实评测配置；API Key 只写入未跟踪的 .env。
SHAREO_AI_LLM_BASE_URL=https://api.deepseek.com/v1
SHAREO_AI_LLM_MODEL=deepseek-v4-flash
SHAREO_AI_LLM_API_KEY=

# Hugging Face 镜像可按网络环境覆盖；已有模型缓存时优先复用缓存。
SHAREO_AI_HF_ENDPOINT=https://huggingface.co
SHAREO_AI_MODEL_CACHE_DIR=.cache/shareo/models
SHAREO_AI_TEXT_MODEL_CACHE_DIR=.cache/shareo/models

# 本机 Go/Python 进程可选的代理地址；本地服务使用 127.0.0.1 互联。
SHAREO_HTTP_PROXY=
SHAREO_HTTPS_PROXY=
SHAREO_ALL_PROXY=
SHAREO_NO_PROXY=localhost,127.0.0.1,::1
SHAREO_AI_HTTP_PROXY=
SHAREO_AI_HTTPS_PROXY=
SHAREO_AI_ALL_PROXY=
SHAREO_AI_NO_PROXY=localhost,127.0.0.1,::1

# 本机运行直接使用宿主机模型缓存目录；不启动旧容器或独立向量服务。
