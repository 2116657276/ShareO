# ShareO 本地配置示例。复制为 .env 后填写本机值；.env 不得提交。

# 本地服务端口
SHAREO_APP_PORT=8080
SHAREO_AI_PORT=8000
SHAREO_RUNTIME=local
SHAREO_AI_BASE_URL=http://127.0.0.1:8000
SHAREO_POST_SEARCH_SEMANTIC_THRESHOLD=0.54
SHAREO_AI_REDIS_URL=redis://127.0.0.1:6379/0
SHAREO_AI_QDRANT_URL=http://127.0.0.1:6333
SHAREO_AI_GO_BASE_URL=http://127.0.0.1:8080

# 内部服务认证；请替换为随机值，不要写入报告或截图。
SHAREO_INTERNAL_TOKEN=replace-with-a-random-value

# DeepSeek 真实评测配置；API Key 只写入未跟踪的 .env。
SHAREO_AI_LLM_BASE_URL=https://api.deepseek.com/v1
SHAREO_AI_LLM_MODEL=deepseek-v4-flash
SHAREO_AI_LLM_API_KEY=

# Hugging Face 镜像可按网络环境覆盖；已有模型缓存时优先复用缓存。
SHAREO_AI_HF_ENDPOINT=https://huggingface.co
SHAREO_AI_MODEL_CACHE_DIR=.cache/shareo/models
SHAREO_AI_TEXT_MODEL_CACHE_DIR=.cache/shareo/models

# Docker/Colima 可访问的代理地址。不要填写容器内不可达的宿主机 127.0.0.1。
SHAREO_HTTP_PROXY=
SHAREO_HTTPS_PROXY=
SHAREO_ALL_PROXY=
SHAREO_NO_PROXY=localhost,127.0.0.1,::1
SHAREO_AI_HTTP_PROXY=
SHAREO_AI_HTTPS_PROXY=
SHAREO_AI_ALL_PROXY=
SHAREO_AI_NO_PROXY=localhost,127.0.0.1,::1,app,redis,qdrant

# 复用本机或 Docker volume 中已下载的模型；不要把模型目录提交到仓库。
SHAREO_AI_MODEL_CACHE_SOURCE=hf_cache

# 仅用于本机开发的 Qdrant 源码目录；脚本会强制在该目录启动二进制。
SHAREO_QDRANT_SOURCE_DIR=./qdrant
SHAREO_QDRANT_BINARY=./target/release/qdrant
