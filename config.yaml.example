# Copy to config.yaml, or point SHAREO_CONFIG at another YAML file.
server:
  port: 8080
  mode: debug  # debug | release | test
  trusted_origins: []  # Exact extra origins, e.g. ["https://shareo.example.com"]
  # Go ↔ ai-service internal calls use SHAREO_INTERNAL_TOKEN (environment only).
  # Go calls ai-service at SHAREO_AI_BASE_URL (default http://127.0.0.1:8000).

database:
  host: 127.0.0.1
  port: 3306
  user: root
  password: "shareo_pass"  # Development default; override with SHAREO_DB_PASSWORD in production
  dbname: shareo
  charset: utf8mb4
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600  # seconds

redis:
  host: 127.0.0.1
  port: 6379
  password: ""  # Or use env: SHAREO_REDIS_PASSWORD
  db: 0
  pool_size: 10

minio:
  endpoint: 127.0.0.1:9000
  access_key: minioadmin  # Development default; override with SHAREO_MINIO_ACCESS_KEY
  secret_key: minioadmin  # Development default; override with SHAREO_MINIO_SECRET_KEY
  bucket: shareo
  use_ssl: false

jwt:
  secret: change-this-to-a-random-string  # Or use env: SHAREO_JWT_SECRET
  expire_hours: 72
  login_cache_ttl_min: 30  # Redis login cache TTL in minutes (0 to disable)

upload:
  max_size: 52428800  # 50MB
  allowed_types:
    - image/jpeg
    - image/png
    - image/webp
    - image/gif
