# Copy to .local/shareo/orbstack/.env, fill local values, and pass it explicitly:
#   --env-file .local/shareo/orbstack/.env
# Do not use the repository's native .env with this stack.

# PostgreSQL 17 + pgvector. The bootstrap script creates shareo_app and shareo_ai.
SHAREO_PG_DATABASE=shareo
SHAREO_PG_ADMIN_USER=shareo_admin
SHAREO_PG_ADMIN_PASSWORD=replace-with-a-local-admin-password
SHAREO_DB_USER=shareo_app
SHAREO_DB_PASSWORD=replace-with-a-local-app-password
SHAREO_AI_DB_USER=shareo_ai
SHAREO_AI_DB_PASSWORD=replace-with-a-local-ai-password

# Go runtime secrets.
SHAREO_JWT_SECRET=replace-with-a-random-jwt-secret
SHAREO_INTERNAL_TOKEN=replace-with-a-random-internal-token

# AI callback override for the intentional 401 recovery check. Leave empty normally.
SHAREO_AI_INTERNAL_TOKEN_OVERRIDE=

# MinIO root credentials. The bucket is created by Go on startup.
SHAREO_MINIO_ACCESS_KEY=replace-with-a-local-minio-access-key
SHAREO_MINIO_SECRET_KEY=replace-with-a-local-minio-secret-key

# Empty means no external LLM. For a fixture on the pilot network, use its
# container DNS name in the base URL and set the fixture key and model.
SHAREO_AI_LLM_BASE_URL=
SHAREO_AI_LLM_API_KEY=
SHAREO_AI_LLM_MODEL=deepseek-chat
SHAREO_AI_LLM_TIMEOUT_SECONDS=30

# Short reclaim settings are safe for local fault/recovery checks.
SHAREO_AI_BOT_RECLAIM_INTERVAL_MS=2000
SHAREO_AI_BOT_MIN_IDLE_TIME_MS=2000
SHAREO_AI_EMBEDDING_CONCURRENCY=1
SHAREO_AI_AGENT_ENABLED=true

# Model download endpoint and optional container proxy.
SHAREO_AI_HF_ENDPOINT=https://huggingface.co
SHAREO_AI_HTTP_PROXY=
SHAREO_AI_HTTPS_PROXY=
SHAREO_AI_ALL_PROXY=
SHAREO_AI_NO_PROXY=localhost,127.0.0.1,::1,app,redis,postgres,minio,ai-service

# Go build proxy settings; unrelated to model download.
SHAREO_HTTP_PROXY=
SHAREO_HTTPS_PROXY=
SHAREO_ALL_PROXY=
SHAREO_NO_PROXY=localhost,127.0.0.1,::1

# Search thresholds already used by the native runtime.
SHAREO_POST_SEARCH_SEMANTIC_THRESHOLD=0.54
SHAREO_IMAGE_SEARCH_SCORE_THRESHOLD=0.39
